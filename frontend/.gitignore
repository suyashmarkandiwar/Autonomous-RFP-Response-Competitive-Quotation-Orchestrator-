# ──────────────────────────────────────────
# Vite + React + Tailwind — .gitignore
# ──────────────────────────────────────────

# ── Dependencies ──────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Output ──────────────────────────
dist/
dist-ssr/
build/
out/

# ── Vite Cache ────────────────────────────
.vite/
vite.config.js.timestamp-*

# ── Tailwind / PostCSS Cache ──────────────
.tailwind-cache/

# ── Environment Variables (Secrets) ──────
.env
.env.*
!.env.example
*.local

# ── Logs ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ───────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ────────────────────────────
*.tsbuildinfo

# ── OS Files ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Editor / IDE ──────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace
